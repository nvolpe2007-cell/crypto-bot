KRAKEN_API_KEY=your_key_here
KRAKEN_API_SECRET=your_secret_here

TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_ENABLED=true

PAPER_TRADING=true
TRADING_MODE=paper
INITIAL_CAPITAL=100

FAST_EMA=9
SLOW_EMA=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

MAX_POSITION_SIZE=50
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=3.0
MAX_DAILY_LOSS=10

TRADING_PAIRS=BTC/USD,ETH/USD,SOL/USD
TIMEFRAME=1m

# ── Meme radar (optional) — see MEME_RADAR.md ────────────────────────────────
# The radar and scorecard need nothing here; they post via TELEGRAM_BOT_TOKEN
# above. These three are ONLY for scripts/telegram_ingest.py, which READS the
# alpha channels you are in. The bot token cannot do that — reading requires a
# user session, which is what api_id/api_hash are for.
# Get them from https://my.telegram.org > API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma-separated channel usernames (the USERNAME column from --list-channels).
TELEGRAM_INGEST_CHANNELS=
