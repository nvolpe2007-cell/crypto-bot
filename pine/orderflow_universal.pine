//@version=6
//
// Volume-Flow Universal — STRATEGY (crypto AND stocks, any timeframe)
// ───────────────────────────────────────────────────────────────────────────────
// A buy/sell strategy built to run on ANY symbol with a volume feed — crypto spot,
// crypto perps, or stocks/ETFs. orderflow_regime_5m.pine and orderflow_regime_
// strategy.pine are crypto-PERP-ONLY: their core edge is the flow x open-interest
// regime classifier, and open interest in that sense does not exist for stocks or
// crypto spot. This script drops OI entirely and rebuilds the signal from the two
// things every market publishes — price and volume — so it is not a re-skin, it
// is a different, weaker hypothesis with the OI confirmation layer removed.
//
// WHAT CHANGED VS THE OI VERSION, AND WHY IT MATTERS
//   The OI-regime layer was what told you WHY volume was moving (fresh
//   conviction vs. forced liquidation vs. covering) — without it, this script can
//   only see THAT volume moved, not why. Expect this to be noisier and less
//   selective per-signal than the perp version. It substitutes a trend filter
//   (price vs. its own moving average) for the regime classifier as the second
//   confirming leg, which is a weaker, more generic form of confirmation.
//
// TWO MODES
//   Trend       — buy strong buying-volume bursts that agree with the prevailing
//                 trend (price > trend MA). Momentum continuation.
//   Reversal    — buy when a recent burst of heavy SELLING volume is decaying and
//                 price has stopped making new lows (capitulation-fade). Mirrors
//                 the perp version's "exhaustion" mode without needing OI to
//                 confirm the selling was forced.
//   Run both and compare on YOUR instrument — there is no prior result transferred
//   from the OI version to lean on here, this is an unproven hypothesis from bar one.
//
// COSTS ARE ON BY DEFAULT — SET THEM FOR YOUR VENUE
//   Crypto taker is commonly ~0.1-0.26% per side; many stock brokers charge zero
//   commission but you still cross the bid/ask spread, which the slippage input
//   approximates. A backtest with both at zero will look dramatically better than
//   reality on ANY instrument. Set commissionPct and slippageTicks for what you
//   actually pay before trusting a number this produces.
//
// HONEST FRAMING
//   This is a hypothesis you can SEE, not a validated edge, on ANY symbol you run
//   it on. No walk-forward, no multiple-testing correction, no out-of-sample split.
//   Removing the OI confirmation layer makes this weaker than the crypto-perp
//   version, not stronger — broader applicability is not the same thing as a
//   better edge. Treat a good-looking curve as a reason to test further, never as
//   a reason to deploy money.
//
// WIN RATE VS EDGE — THIS IS THE DEFAULT CONFIG NOW, READ THIS FIRST
//   Default mode is Reversal, useTP is ON, tpMult=1.5 against the 3.0 atrMult
//   stop (a 1:2 reward:risk) — set this way on request, to hit a 60-70%+ win
//   rate. Tested on TradingView, full available history, 1h chart:
//     AAPL 1h:      69.16% win rate, 856 trades, but PROFIT FACTOR 0.868 (net loss)
//     BTCUSDT.P 1h: 64.14% win rate, 909 trades, but PROFIT FACTOR 0.638, -91% equity
//   Both clear 60-70% win rate. Neither is profitable. A target much smaller than
//   the stop mechanically produces more, smaller wins and fewer, larger losses —
//   the win-rate number goes up while expectancy goes down, because the losses
//   that do happen are big enough to erase many small wins. This is the same
//   "costs dominate, high win rate isn't the same as an edge" lesson the rest of
//   this repo has already learned the hard way, showing up in a new shape: high
//   win rate purchased with tail risk instead of with transaction costs. The
//   defaults below optimize for the win-rate NUMBER, on request — they do not
//   optimize for money. Judge this by profit factor / expectancy, never by the
//   win-rate percentage in isolation, before trading it.
// ───────────────────────────────────────────────────────────────────────────────

strategy("Volume Flow Universal — Strategy", shorttitle = "VolFlow Universal",
     overlay                 = true,
     initial_capital         = 1000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.1,
     slippage                = 2,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     max_labels_count        = 500)

// ── inputs ────────────────────────────────────────────────────────────────────

var string GRP_MODE = "Mode"
var string GRP_FLOW = "Flow"
var string GRP_TREND = "Trend filter"
var string GRP_SIG  = "Entry conditions"
var string GRP_EXIT = "Exit"

mode = input.string("Reversal", "Signal mode", options = ["Trend", "Reversal", "Both"],
     group = GRP_MODE, tooltip = "Trend = buy volume bursts that agree with the " +
     "prevailing trend (momentum). Reversal = fade a decaying selling burst once " +
     "price stops making new lows (capitulation fade). Compare them on your symbol.")
allowLong  = input.bool(true,  "Allow longs",  group = GRP_MODE)
allowShort = input.bool(false, "Allow shorts", group = GRP_MODE,
     tooltip = "Leave off on a cash/spot account that cannot short. Turn on for " +
               "a margin/futures account.")

useLowerTf = input.bool(true, "Use intrabar volume delta", group = GRP_FLOW)
lowerTf    = input.timeframe("1", "Intrabar timeframe", group = GRP_FLOW,
     tooltip = "Must be LOWER than the chart timeframe. On US equities this only " +
     "resolves during that lower timeframe's own trading hours; outside them the " +
     "script falls back to the bar proxy automatically (see the status table).")
zLen       = input.int(40, "Z-score length", minval = 5, group = GRP_FLOW,
     tooltip = "In bars of the CHART timeframe, whatever that is set to.")

trendLen = input.int(50, "Trend MA length", minval = 2, group = GRP_TREND,
     tooltip = "Continuation longs require close above this MA (shorts below it). " +
     "This is the stand-in for the OI-regime confirmation the perp version has " +
     "and this one does not.")
trendType = input.string("EMA", "Trend MA type", options = ["EMA", "SMA"], group = GRP_TREND)
trendMA = trendType == "EMA" ? ta.ema(close, trendLen) : ta.sma(close, trendLen)

zThresh = input.float(1.5, "Min |delta z| to act", minval = 0.0, step = 0.25,
     group = GRP_SIG, tooltip = "Raised above the OI version's 1.25 on purpose: " +
     "without OI to separate forced flow from conviction flow, selectivity has to " +
     "come entirely from the flow threshold. Never lower this to force more trades.")
extLb   = input.int(24, "Extreme lookback (bars)", minval = 2, group = GRP_SIG,
     tooltip = "Window Reversal mode looks back in for a prior selling extreme.")
decayLb = input.int(6,  "Flow decay lookback (bars)", minval = 2, group = GRP_SIG)

confirmBars = input.int(1, "Require signal to hold N bars", minval = 1, group = GRP_SIG,
     tooltip = "1 = enter the instant the condition is true (often the exact peak " +
     "of a flow burst). 2+ requires it to hold N consecutive bars first. On the " +
     "crypto-perp version, a 1-bar OI-regime label was too noisy for this to " +
     "survive at 2 -- on THIS script the condition is continuous (a z-score, no " +
     "discrete regime label) so persistence should behave more predictably, but " +
     "test it on your own symbol before trusting that.")
breakoutConfirm = input.bool(false, "Require a fresh local high/low on entry bar",
     group = GRP_SIG, tooltip = "Long only fires if price is ALSO making a new " +
     "N-bar high on the entry bar -- confirms the move is still moving at the " +
     "moment of entry, not just that flow was strong recently. Off by default, A/B it.")
breakoutLb = input.int(10, "Breakout lookback (bars)", minval = 2, group = GRP_SIG)

holdBars = input.int(48, "Time exit (bars)", minval = 1, group = GRP_EXIT,
     tooltip = "In bars of the chart timeframe -- 48 bars on a 5m chart is 4h, " +
     "48 bars on a daily chart is 48 days. Set this relative to YOUR timeframe.")
useStop  = input.bool(true, "Use ATR stop", group = GRP_EXIT)
atrLen   = input.int(20, "ATR length", minval = 1, group = GRP_EXIT)
atrMult  = input.float(3.0, "ATR stop multiple", minval = 0.5, step = 0.5,
     group = GRP_EXIT, tooltip = "Deliberately wide -- a tight stop here harvests " +
     "ordinary noise rather than protecting anything.")
useTP    = input.bool(true, "Use take-profit", group = GRP_EXIT,
     tooltip = "A target much smaller than the stop mechanically raises the win " +
     "rate -- small moves hit it before a wide stop gets tested. THIS IS A " +
     "WIN-RATE LEVER, NOT AN EDGE LEVER: a high win rate with a bad payoff ratio " +
     "can still be net-negative once costs are included, which is this repo's " +
     "central finding across every strategy it has tested. Judge this by the " +
     "Total P&L / profit factor the strategy tester reports, never by the win " +
     "rate percentage alone. ON BY DEFAULT to match the tested 60-70%-win-rate " +
     "config (see header) -- that config's profit factor was BELOW 1 on both " +
     "assets tested. Defaulting it on makes the win rate the thing you see " +
     "first; it does not make the strategy profitable.")
tpMult   = input.float(1.5, "TP ATR multiple", minval = 0.1, step = 0.1, group = GRP_EXIT,
     tooltip = "Smaller than the stop multiple = higher win rate, worse " +
     "reward:risk per trade. Tested: 0.5 vs a 3.0 stop (1:6) actually CUT the win " +
     "rate to ~13% on AAPL 5m -- the target was small enough that round-trip cost " +
     "ate it, turning nominal wins into net losers. 1.5 vs 3.0 (1:2) is what " +
     "produced 60-70%+ win rates (see header) -- and was still net-negative on " +
     "profit factor. There is no free win-rate lever here.")

// ── volume delta ──────────────────────────────────────────────────────────────

intrabarSigned = close > open ? volume : close < open ? -volume : 0.0
lowerArr = request.security_lower_tf(syminfo.tickerid, lowerTf, intrabarSigned,
     ignore_invalid_timeframe = true)
lowerOk  = not na(lowerArr) and array.size(lowerArr) > 0

span  = high - low
clv   = span == 0 ? 0.0 : ((close - low) - (high - close)) / span
proxy = clv * volume

usingIntrabar = useLowerTf and lowerOk
delta = nz(usingIntrabar ? array.sum(lowerArr) : proxy)

zOf(src, len) =>
    m = ta.sma(src, len)
    s = ta.stdev(src, len)
    s > 0 ? (src - m) / s : 0.0

deltaZ = zOf(delta, zLen)

// ── trend continuation ────────────────────────────────────────────────────────

uptrend   = close > trendMA
downtrend = close < trendMA

contLong  = uptrend   and deltaZ >=  zThresh
contShort = downtrend and deltaZ <= -zThresh

// ── reversal / exhaustion (no OI: a prior FLOW extreme stands in for "forced") ──
// Compares against the PRIOR window, never one including the current bar, so a
// flat tape can never register as "no new extreme" on a bar that IS the extreme.

mag      = math.abs(delta)
priorMag = ta.sma(mag[1], decayLb)
decaying = not na(priorMag) and mag < priorMag

hadSellExtreme = ta.lowest(deltaZ, extLb)  <= -zThresh
hadBuyExtreme  = ta.highest(deltaZ, extLb) >=  zThresh

priorMin = ta.lowest(low[1], extLb)
priorMax = ta.highest(high[1], extLb)
noNewLow  = not na(priorMin) and low  >= priorMin
noNewHigh = not na(priorMax) and high <= priorMax

exhaustLong  = hadSellExtreme and decaying and noNewLow
exhaustShort = hadBuyExtreme  and decaying and noNewHigh

// ── entry conditions ──────────────────────────────────────────────────────────

wantTrend = mode == "Trend"    or mode == "Both"
wantRev   = mode == "Reversal" or mode == "Both"

rawLong  = (wantTrend and contLong)  or (wantRev and exhaustLong)
rawShort = (wantTrend and contShort) or (wantRev and exhaustShort)

var int longStreak  = 0
var int shortStreak = 0
longStreak  := rawLong  ? longStreak  + 1 : 0
shortStreak := rawShort ? shortStreak + 1 : 0
persistLong  = longStreak  >= confirmBars
persistShort = shortStreak >= confirmBars

priorHighBo = ta.highest(high[1], breakoutLb)
priorLowBo  = ta.lowest(low[1], breakoutLb)
breakoutLongOk  = not breakoutConfirm or (not na(priorHighBo) and high >= priorHighBo)
breakoutShortOk = not breakoutConfirm or (not na(priorLowBo)  and low  <= priorLowBo)

longSignal  = allowLong  and persistLong  and breakoutLongOk
shortSignal = allowShort and persistShort and breakoutShortOk

// ── execution ─────────────────────────────────────────────────────────────────

atr = ta.atr(atrLen)

if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if shortSignal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)

barsHeld = strategy.position_size != 0 ? bar_index - strategy.opentrades.entry_bar_index(0) : 0
if strategy.position_size != 0 and barsHeld >= holdBars
    strategy.close_all(comment = "time")

longStop  = useStop ? strategy.position_avg_price - atrMult * atr : na
shortStop = useStop ? strategy.position_avg_price + atrMult * atr : na
longTP    = useTP   ? strategy.position_avg_price + tpMult  * atr : na
shortTP   = useTP   ? strategy.position_avg_price - tpMult  * atr : na

if (useStop or useTP) and strategy.position_size > 0
    strategy.exit("Long exit", from_entry = "Long", stop = longStop, limit = longTP)
if (useStop or useTP) and strategy.position_size < 0
    strategy.exit("Short exit", from_entry = "Short", stop = shortStop, limit = shortTP)

// ── chart markers ─────────────────────────────────────────────────────────────

plotshape(longSignal  and strategy.position_size == 0, "BUY", shape.labelup,
     location.belowbar, color.new(#26a69a, 0), text = "BUY",
     textcolor = color.white, size = size.small)
plotshape(shortSignal and strategy.position_size == 0, "SELL", shape.labeldown,
     location.abovebar, color.new(#ef5350, 0), text = "SELL",
     textcolor = color.white, size = size.small)

plot(trendMA, "Trend MA", color = color.new(#787b86, 40), linewidth = 1)

// ── status table ──────────────────────────────────────────────────────────────

if barstate.islast
    var table t = table.new(position.top_right, 2, 4,
         frame_color = color.new(color.gray, 70), frame_width = 1)
    txt = color.new(color.gray, 0)
    val = color.new(#b2b5be, 0)
    warn = color.new(#ffa726, 0)

    table.cell(t, 0, 0, "source",  text_color = txt, text_size = size.tiny)
    table.cell(t, 1, 0, usingIntrabar ? lowerTf + " intrabar" : "bar proxy",
         text_color = usingIntrabar ? val : warn, text_size = size.tiny)
    table.cell(t, 0, 1, "mode",    text_color = txt, text_size = size.tiny)
    table.cell(t, 1, 1, mode, text_color = val, text_size = size.tiny)
    table.cell(t, 0, 2, "delta z", text_color = txt, text_size = size.tiny)
    table.cell(t, 1, 2, str.tostring(deltaZ, "#.00"), text_color = val, text_size = size.tiny)
    table.cell(t, 0, 3, "trend",   text_color = txt, text_size = size.tiny)
    table.cell(t, 1, 3, uptrend ? "up" : downtrend ? "down" : "flat",
         text_color = val, text_size = size.tiny)
