//@version=6
//
// Market-neutral PAIRS — ratio z-score on the three real Kraken pairs
// ──────────────────────────────────────────────────────────────────────────────
// PORT OF: pairs_paper.py (state: data/pairs_paper_state.json, judged by
//          proof_scorecard._pairs_forward)
//
// INSTRUMENTS — PINNED, AND CHART-INDEPENDENT
//   The runner trades exactly three pairs, built by itertools.combinations over
//   {BTC, ETH, SOL} and then SORTED, which fixes both the membership and the
//   ORIENTATION of every pair:
//
//        ('BTC','ETH')      ('BTC','SOL')      ('ETH','SOL')
//
//   Leg A is always the alphabetically-first of the two. That is not cosmetic —
//   the spread is ln(P_a) - ln(P_b), so swapping the legs flips the sign of z and
//   inverts every long/short instruction this script gives you. So the pair is a
//   DROPDOWN here, not two free-form symbol boxes, and both legs are fetched by
//   name. It does not matter what chart you put this on; it reads the same three
//   Kraken spot series the runner reads.
//
//   Prices come from Kraken SPOT (the runner calls api.kraken.com/0/public/OHLC),
//   on HOURLY bars (PAIRS_INTERVAL_MIN = 60). Both are pinned below. The SHORT
//   leg is a simulated perp — a US Kraken-spot account cannot short — so no
//   futures symbol would be correct here either.
//
// THE SPEC (pre-specified in the runner, not swept)
//   spread s = ln(P_a) - ln(P_b), z-scored over 168 bars (7 days hourly).
//   ENTRY  |z| >= 2.0    z > 0 (A rich vs B) -> SHORT A + LONG B
//                        z < 0               -> LONG  A + SHORT B
//   EXIT   |z| <= 0.5    convergence captured
//   STOP   |z| >= 3.5    the spread broke down; it is not mean-reverting
//   TIME   held > 168 bars
//
// WHY THIS IS AN INDICATOR AND NOT A strategy()
//   The trade is DOLLAR-NEUTRAL and has TWO legs. A Pine strategy can only send
//   orders for the one instrument the chart is showing, so it cannot hold both,
//   and any strategy() version would quietly be backtesting a one-legged
//   directional bet — which is a different strategy with a different risk. Rather
//   than fake it, this computes the exact signal and tells you which leg goes
//   which way.
//
// THE COST WALL IS THE WHOLE QUESTION
//   A pair round-trip pays FOUR legs of fees (in and out, twice) plus a funding
//   drag on the short leg. The spread must converge by more than all of that.
//
// ⚠ AND THE SEARCH THAT ALREADY RAN SAYS IT DOES NOT
//   The 2026-07-13 exhaustive search put ~320 strategies through a Monte-Carlo +
//   multiple-testing + OOS gauntlet and got ZERO survivors. Cointegration pairs
//   were among them, and the pairs near-miss "was luck — it breaks OOS."
//   See memory exhaustive_search_320_zero. This is here to be inspected, not
//   because the edge is believed.
//
indicator("Market-neutral pairs — Kraken BTC/ETH/SOL", overlay = false)

// ── the pair: pinned to the runner's three, in the runner's orientation ───────
pairSel = input.string("ETH / BTC   (A=ETH, B=BTC)", "Pair",
     options = ["ETH / BTC   (A=ETH, B=BTC)",
                "SOL / BTC   (A=SOL, B=BTC)",
                "SOL / ETH   (A=SOL, B=ETH)"],
     group = "Instruments",
     tooltip = "The runner's three pairs. Leg A is fixed by the runner's sorted ordering — do not swap them, it inverts z and every instruction below.")

exch = input.string("KRAKEN", "Exchange", options = ["KRAKEN", "COINBASE", "BITSTAMP"],
     group = "Instruments",
     tooltip = "KRAKEN is the runner's actual data source and the account's venue. The others are for cross-checking that a signal is not a single-venue artefact.")

tfSel = input.string("60", "Bar interval  (PAIRS_INTERVAL_MIN)",
     options = ["60", "240", "D"], group = "Instruments",
     tooltip = "60 = hourly, the runner default. The z-score lookback below is counted in these bars.")

// Kraken spells BTC as XBT; the other venues do not.
btcSym  = exch == "KRAKEN" ? "KRAKEN:XBTUSD"  : exch == "COINBASE" ? "COINBASE:BTCUSD"  : "BITSTAMP:BTCUSD"
ethSym  = exch == "KRAKEN" ? "KRAKEN:ETHUSD"  : exch == "COINBASE" ? "COINBASE:ETHUSD"  : "BITSTAMP:ETHUSD"
solSym  = exch == "KRAKEN" ? "KRAKEN:SOLUSD"  : exch == "COINBASE" ? "COINBASE:SOLUSD"  : "BITSTAMP:SOLUSD"

isEthBtc = pairSel == "ETH / BTC   (A=ETH, B=BTC)"
isSolBtc = pairSel == "SOL / BTC   (A=SOL, B=BTC)"

symA = isEthBtc ? ethSym : isSolBtc ? solSym : solSym
symB = isEthBtc ? btcSym : isSolBtc ? btcSym : ethSym
labA = isEthBtc ? "ETH"  : "SOL"
labB = isEthBtc ? "BTC"  : isSolBtc ? "BTC" : "ETH"

// ── spec inputs ───────────────────────────────────────────────────────────────
lookback = input.int(168, "Z-score lookback, bars  (PAIRS_LOOKBACK)", minval = 5, group = "Spec")
entryZ   = input.float(2.0, "Entry |z|  (PAIRS_ENTRY_Z)", minval = 0.1, step = 0.1, group = "Spec")
exitZ    = input.float(0.5, "Exit |z|  (PAIRS_EXIT_Z)",  minval = 0.0, step = 0.1, group = "Spec")
stopZ    = input.float(3.5, "Stop |z|  (PAIRS_STOP_Z)",  minval = 0.1, step = 0.1, group = "Spec")
maxHold  = input.int(168, "Max hold, bars  (PAIRS_MAX_HOLD_BARS)", minval = 1, group = "Spec")

// ── data: both legs by name, so the chart symbol is irrelevant ────────────────
pa = request.security(symA, tfSel, close, lookahead = barmerge.lookahead_off)
pb = request.security(symB, tfSel, close, lookahead = barmerge.lookahead_off)

spread = math.log(pa) - math.log(pb)
mu     = ta.sma(spread, lookback)
sd     = ta.stdev(spread, lookback)
z      = not na(sd) and sd > 0 ? (spread - mu) / sd : na

// ── position state machine, mirroring the runner ──────────────────────────────
// +1 = LONG A / SHORT B      -1 = SHORT A / LONG B      0 = flat
var int   pairPos  = 0
var int   heldBars = 0

opened   = false
closed   = false
string closeWhy = ""

if not na(z)
    if pairPos != 0
        heldBars += 1
        if math.abs(z) <= exitZ
            pairPos  := 0
            closed   := true
            closeWhy := "converged"
        else if math.abs(z) >= stopZ
            pairPos  := 0
            closed   := true
            closeWhy := "spread broke down"
        else if heldBars >= maxHold
            pairPos  := 0
            closed   := true
            closeWhy := "time stop"
    else
        if z >= entryZ
            pairPos  := -1            // A is rich -> short A, long B
            heldBars := 0
            opened   := true
        else if z <= -entryZ
            pairPos  := 1             // A is cheap -> long A, short B
            heldBars := 0
            opened   := true

// ── plotting ──────────────────────────────────────────────────────────────────
zc = pairPos == 1 ? color.teal : pairPos == -1 ? color.red : color.gray
plot(z, "z-score", color = color.new(zc, 0), linewidth = 2)
hline(0, "mean", color = color.new(color.gray, 50))
hline(entryZ,  "entry +", color = color.new(color.orange, 30), linestyle = hline.style_dashed)
hline(-entryZ, "entry -", color = color.new(color.orange, 30), linestyle = hline.style_dashed)
hline(exitZ,   "exit +",  color = color.new(color.teal, 50), linestyle = hline.style_dotted)
hline(-exitZ,  "exit -",  color = color.new(color.teal, 50), linestyle = hline.style_dotted)
hline(stopZ,   "stop +",  color = color.new(color.red, 40),  linestyle = hline.style_dashed)
hline(-stopZ,  "stop -",  color = color.new(color.red, 40),  linestyle = hline.style_dashed)
bgcolor(pairPos != 0 ? color.new(zc, 92) : na, title = "In a pair")

plotshape(opened and pairPos == 1,  "LONG A / SHORT B", style = shape.labelup,
     location = location.bottom, color = color.new(color.teal, 0),
     text = "LONG A\nSHORT B", textcolor = color.white, size = size.tiny)
plotshape(opened and pairPos == -1, "SHORT A / LONG B", style = shape.labeldown,
     location = location.top, color = color.new(color.red, 0),
     text = "SHORT A\nLONG B", textcolor = color.white, size = size.tiny)
plotshape(closed, "CLOSE", style = shape.xcross, location = location.bottom,
     color = color.new(color.yellow, 0), size = size.tiny)

var table t = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "leg A", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 0, labA + "  " + symA, text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 1, "leg B", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, labB + "  " + symB, text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 2, "z now", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, na(z) ? "warming up" : str.tostring(z, "#.##"), text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 3, "position", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, pairPos == 1 ? "LONG " + labA + " / SHORT " + labB :
                        pairPos == -1 ? "SHORT " + labA + " / LONG " + labB : "flat",
         text_color = pairPos == 0 ? color.gray : color.new(zc, 0), text_size = size.small)
    table.cell(t, 0, 4, "bars held", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, pairPos == 0 ? "-" : str.tostring(heldBars) + " / " + str.tostring(maxHold),
         text_color = color.gray, text_size = size.small)

alertcondition(opened and pairPos == 1,  "Pairs: LONG A / SHORT B", "Pairs: z <= -entry -> LONG leg A, SHORT leg B")
alertcondition(opened and pairPos == -1, "Pairs: SHORT A / LONG B", "Pairs: z >= +entry -> SHORT leg A, LONG leg B")
alertcondition(closed, "Pairs: CLOSE", "Pairs: position closed")
