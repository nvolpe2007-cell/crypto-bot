//@version=6
//
// Rebalanced allocation — crypto / gold / cash, periodically rebalanced
// ──────────────────────────────────────────────────────────────────────────────
// PORT OF: rebalance_paper.py (state: data/rebalance_paper_state.json)
//
// WHY THIS ONE MATTERS MORE THAN THE OTHERS IN THIS FOLDER
//   After ~320 strategies across 9 dimensions cleared ZERO survivors of the
//   Monte-Carlo + multiple-testing + OOS gauntlet, this was THE ONE lever with
//   genuine, robust, out-of-sample positive expectancy — and it is STRUCTURAL,
//   not predictive. It forecasts nothing. It harvests the rebalancing premium
//   (Shannon's demon) by systematically selling what rose and buying what fell,
//   and it dilutes crypto's drawdown with an uncorrelated asset.
//   Measured: 50% crypto / 25% gold (PAXG, ~0.17 correlation) / 25% cash,
//   rebalanced monthly -> +6.9% full cycle, Sharpe 0.27, roughly HALF the
//   drawdown of crypto-only, over a window where buy-and-hold LOST.
//   See memory rebalance_premium_verdict.
//
// AND THE HONEST LIMIT OF IT
//   This is DOWNSIDE PROTECTION, NOT ALPHA. It cannot profit in a full bear —
//   it can only lose far less. Anyone reading the curve below as "the strategy
//   that finally works" has misread what it does. It is judged on the same
//   pre-registered proof bar as every other arm, and it does not get a pass for
//   being the least-bad idea in the drawer.
//
// WHY IT IS AN INDICATOR AND NOT A strategy()
//   A Pine strategy trades only the chart's instrument; this holds eleven at
//   once. So this script COMPUTES the portfolio's equity curve from live prices
//   via request.security and plots it against buy-and-hold, rather than
//   pretending to place orders. The curve is the deliverable.
//
// INVERSE-VOL SLEEVE WEIGHTING (the runner's default)
//   Each coin is weighted inversely to its trailing 60-day realized volatility,
//   so a coin twice as volatile as another gets half the weight and no single
//   high-vol name dominates the sleeve's risk. Backtested honestly, this beat
//   equal-weight over 5 years but only modestly (-17.7% vs -20.2% total, about
//   the same Sharpe). It makes a loser slightly less bad; it does not make a
//   winner. The actual defensiveness lives in the 25% gold / 25% cash structure,
//   which is why that structure is the part not to fiddle with.
//
indicator("Rebalanced allocation (crypto / gold / cash)", overlay = false)

// ── universe (the runner's default 10 majors + PAXG) ──────────────────────────
s1 = input.symbol("KRAKEN:XBTUSD",  "Crypto 1",  group = "Crypto sleeve")
s2 = input.symbol("KRAKEN:ETHUSD",  "Crypto 2",  group = "Crypto sleeve")
s3 = input.symbol("KRAKEN:SOLUSD",  "Crypto 3",  group = "Crypto sleeve")
s4 = input.symbol("KRAKEN:XRPUSD",  "Crypto 4",  group = "Crypto sleeve")
s5 = input.symbol("KRAKEN:ADAUSD",  "Crypto 5",  group = "Crypto sleeve")
s6 = input.symbol("KRAKEN:LINKUSD", "Crypto 6",  group = "Crypto sleeve")
s7 = input.symbol("KRAKEN:LTCUSD",  "Crypto 7",  group = "Crypto sleeve")
s8 = input.symbol("KRAKEN:BCHUSD",  "Crypto 8",  group = "Crypto sleeve")
s9 = input.symbol("KRAKEN:AVAXUSD", "Crypto 9",  group = "Crypto sleeve")
s10 = input.symbol("KRAKEN:DOGEUSD","Crypto 10", group = "Crypto sleeve")
sGold = input.symbol("KRAKEN:PAXGUSD", "Gold  (REBALANCE_GOLD)", group = "Structure")

cryptoFrac = input.float(50.0, "Crypto %  (REBALANCE_CRYPTO_FRAC)", minval = 0, maxval = 100, step = 5, group = "Structure") / 100.0
goldFrac   = input.float(25.0, "Gold %  (REBALANCE_GOLD_FRAC)",     minval = 0, maxval = 100, step = 5, group = "Structure") / 100.0
rebalDays  = input.int(30, "Rebalance every N bars  (REBALANCE_DAYS)", minval = 1, group = "Structure",
     tooltip = "Counted in CHART bars. Put the chart on the DAILY timeframe so 30 bars = the runner's 30 days.")
taker      = input.float(0.26, "Taker fee % on turnover  (REBALANCE_TAKER)", minval = 0, step = 0.01, group = "Structure") / 100.0
invVol     = input.bool(true, "Inverse-vol sleeve weighting  (REBALANCE_WEIGHT_SCHEME)", group = "Structure")
volLb      = input.int(60, "Vol lookback, days  (REBALANCE_VOL_LOOKBACK)", minval = 5, group = "Structure")
startEq    = input.float(1000, "Starting equity", minval = 1, group = "Structure")

cashFrac = math.max(0.0, 1.0 - cryptoFrac - goldFrac)

// ── prices and trailing vol for each sleeve member ────────────────────────────
f_px(simple string sym) => request.security(sym, "D", close, lookahead = barmerge.lookahead_off)
f_vol(simple string sym) => request.security(sym, "D", ta.stdev(close / close[1] - 1, volLb), lookahead = barmerge.lookahead_off)

p1 = f_px(s1)
p2 = f_px(s2)
p3 = f_px(s3)
p4 = f_px(s4)
p5 = f_px(s5)
p6 = f_px(s6)
p7 = f_px(s7)
p8 = f_px(s8)
p9 = f_px(s9)
p10 = f_px(s10)
pg = f_px(sGold)

v1 = f_vol(s1)
v2 = f_vol(s2)
v3 = f_vol(s3)
v4 = f_vol(s4)
v5 = f_vol(s5)
v6 = f_vol(s6)
v7 = f_vol(s7)
v8 = f_vol(s8)
v9 = f_vol(s9)
v10 = f_vol(s10)

// ── holdings, in UNITS, drifting between rebalances ───────────────────────────
var float u1 = 0.0
var float u2 = 0.0
var float u3 = 0.0
var float u4 = 0.0
var float u5 = 0.0
var float u6 = 0.0
var float u7 = 0.0
var float u8 = 0.0
var float u9 = 0.0
var float u10 = 0.0
var float ug = 0.0
var float cash = 0.0
var int   lastRebalBar = na
var bool  seeded = false

allReady = not na(p1) and not na(p2) and not na(p3) and not na(p4) and not na(p5) and not na(p6) and not na(p7) and not na(p8) and not na(p9) and not na(p10) and not na(pg)

// Portfolio mark-to-market on current prices.
f_mtm() =>
    u1*p1 + u2*p2 + u3*p3 + u4*p4 + u5*p5 + u6*p6 + u7*p7 + u8*p8 + u9*p9 + u10*p10 + ug*pg + cash

// Inverse-vol weight for one member, as a share of the CRYPTO sleeve.
// Falls back to equal weight when vol history is missing or degenerate — the
// same fail-safe the runner uses during warm-up or a fetch gap.
invSum = (na(v1) or v1 <= 0 ? 0 : 1/v1) + (na(v2) or v2 <= 0 ? 0 : 1/v2) + (na(v3) or v3 <= 0 ? 0 : 1/v3) + (na(v4) or v4 <= 0 ? 0 : 1/v4) + (na(v5) or v5 <= 0 ? 0 : 1/v5) + (na(v6) or v6 <= 0 ? 0 : 1/v6) + (na(v7) or v7 <= 0 ? 0 : 1/v7) + (na(v8) or v8 <= 0 ? 0 : 1/v8) + (na(v9) or v9 <= 0 ? 0 : 1/v9) + (na(v10) or v10 <= 0 ? 0 : 1/v10)
useInv = invVol and invSum > 0
f_w(float v) => useInv and not na(v) and v > 0 ? cryptoFrac * (1/v) / invSum : cryptoFrac / 10.0

daysSince = na(lastRebalBar) ? 1e9 : bar_index - lastRebalBar
doRebal   = allReady and (not seeded or daysSince >= rebalDays)

var float cumFees = 0.0

if doRebal
    equity = seeded ? f_mtm() : startEq
    // turnover = sum of |target value - current value| across all sleeves
    t1 = equity*f_w(v1)
    t2 = equity*f_w(v2)
    t3 = equity*f_w(v3)
    t4 = equity*f_w(v4)
    t5 = equity*f_w(v5)
    t6 = equity*f_w(v6)
    t7 = equity*f_w(v7)
    t8 = equity*f_w(v8)
    t9 = equity*f_w(v9)
    t10 = equity*f_w(v10)
    tg = equity*goldFrac
    turnover = math.abs(t1 - u1*p1) + math.abs(t2 - u2*p2) + math.abs(t3 - u3*p3) + math.abs(t4 - u4*p4) + math.abs(t5 - u5*p5) + math.abs(t6 - u6*p6) + math.abs(t7 - u7*p7) + math.abs(t8 - u8*p8) + math.abs(t9 - u9*p9) + math.abs(t10 - u10*p10) + math.abs(tg - ug*pg)
    fee = turnover * taker
    cumFees += fee
    equity := equity - fee
    // re-derive targets off the post-fee equity
    u1 := equity*f_w(v1)/p1
    u2 := equity*f_w(v2)/p2
    u3 := equity*f_w(v3)/p3
    u4 := equity*f_w(v4)/p4
    u5 := equity*f_w(v5)/p5
    u6 := equity*f_w(v6)/p6
    u7 := equity*f_w(v7)/p7
    u8 := equity*f_w(v8)/p8
    u9 := equity*f_w(v9)/p9
    u10 := equity*f_w(v10)/p10
    ug  := equity*goldFrac/pg
    cash := equity*cashFrac
    lastRebalBar := bar_index
    seeded := true

portfolio = seeded ? f_mtm() : na

// ── buy-and-hold benchmark: the same crypto sleeve, never rebalanced, no gold ──
var float b1 = 0.0
var bool bInit = false
if allReady and not bInit
    b1 := startEq / p1
    bInit := true
benchmark = bInit ? b1 * p1 : na

plot(portfolio, "Rebalanced portfolio", color = color.new(color.teal, 0), linewidth = 2)
plot(benchmark, "BTC buy & hold",       color = color.new(color.gray, 30), linewidth = 1)
hline(startEq, "start", color = color.new(color.gray, 60), linestyle = hline.style_dotted)
plotshape(doRebal and seeded, "Rebalance", style = shape.triangleup, location = location.bottom,
     color = color.new(color.orange, 0), size = size.tiny)

var table t = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "structure", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 0, str.tostring(cryptoFrac*100, "#") + "/" + str.tostring(goldFrac*100, "#") + "/" + str.tostring(cashFrac*100, "#") + " cr/gold/cash",
         text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 1, "sleeve weighting", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, useInv ? "inverse-vol" : "equal", text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 2, "portfolio", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, na(portfolio) ? "warming up" : "$" + str.tostring(portfolio, "#.##"),
         text_color = na(portfolio) or portfolio >= startEq ? color.teal : color.maroon, text_size = size.small)
    table.cell(t, 0, 3, "BTC buy & hold", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, na(benchmark) ? "-" : "$" + str.tostring(benchmark, "#.##"), text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 4, "fees paid", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, "$" + str.tostring(cumFees, "#.##"), text_color = color.maroon, text_size = size.small)
