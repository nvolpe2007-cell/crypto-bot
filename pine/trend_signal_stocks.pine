//@version=6
//
// Trend Signal (Stocks) — a DRAWDOWN tool, measured across 70 tickers
// ─────────────────────────────────────────────────────────────────────────────────
// WHAT THIS IS, AND WHAT IT IS NOT
//   Close vs SMA(200) with a 1% hysteresis band. Long above, cash below.
//   It is the companion to "Trend Signal (Honest)" (crypto), retuned for equities
//   and, more importantly, HONESTLY RELABELLED after the measurement below.
//
//   It is NOT an alpha indicator. It will not beat buying and holding. It cuts
//   how far you fall.
//
// THE MEASUREMENT THAT DECIDED THAT — 70 US tickers, 2015→2026, 0.10% round-trip
//   (scripts/equity_indicator_lab.py; large caps across 9 sectors + 17 ETFs;
//    every number below is the MEDIAN ACROSS THE UNIVERSE, never the best name)
//
//     SMA(100) + 2% band, the crypto parameters:
//       median win rate      37%          median expectancy   +2.98%/trade
//       median strategy    1.56x          median buy&hold      3.72x
//       BEAT BUY-AND-HOLD:    6% of 70 assets
//       median max DD     -29.3%          buy&hold           -43.4%
//
//     SMA(200) + 1% band, what this script ships:
//       median win rate      29%          median expectancy   +4.40%/trade
//       median strategy    2.05x          median buy&hold      3.82x
//       BEAT BUY-AND-HOLD:    4% of 70 assets
//       median max DD     -24.5%          buy&hold           -43.2%
//       SMALLER DRAWDOWN THAN HOLDING ON 90% OF ASSETS
//
//   Read those two lines together. On 90% of names it takes materially less pain;
//   on 96% of names it makes less money. That is the entire trade, and there is
//   no parameter in this script that escapes it — all 16 cells of the SMA/band
//   grid were tested and NOT ONE had a majority of assets beat buy-and-hold.
//
// WHY SMA(200) AND NOT THE BEST CELL IN THE GRID
//   The 200-day moving average is the canonical equity trend filter, chosen by
//   the entire industry decades before this test existed — not picked by us from
//   the grid we just ran. It also happened to post the smallest drawdown. Had it
//   been an unusual length that merely scored best, it would have been rejected
//   as a fit. Stating this so the choice can be audited rather than trusted.
//
// WHAT IT DOES NOT DO — read this if you came here wanting a high win rate
//   Median win rate is 29%. That is not a defect to be filtered away. Raising the
//   win rate on this family of rule has now been measured FOUR separate times in
//   this repo and destroyed expectancy every time (asymmetric take-profit; a
//   volatility-regime overlay, worse in 12 of 12 cells; a fixed 3R/5R target,
//   which cut the payoff ratio from 8.07 to 2.13; and a never-realise-a-loss
//   construction that reached a 100% win rate by locking capital in one position
//   for 1.7 years at -91.7% unrealised). Win rate is a free parameter. Expectancy
//   and drawdown are not. This script optimises the two that are not free.
//
// HOW TO USE IT
//   Daily chart. Alerts fire on CONFIRMED closes (barstate.isconfirmed), so set
//   every alert to "Once Per Bar Close" — an intrabar alert trades a rule that
//   was never tested.
//
// KNOWN DISCREPANCY — DIVIDEND ADJUSTMENT (verified on SPY, 2026-09-06)
//   The header numbers were measured on DIVIDEND-ADJUSTED closes. TradingView
//   charts unadjusted prices unless the ADJ toggle is on. Verified live: this
//   script reported SMA(200)=712.15 on SPY, which matches unadjusted data to the
//   cent (adjusted gives 709.87). Signal TIMING barely moves — the two MAs differ
//   by ~0.3% — but total RETURN does, because unadjusted prices silently drop
//   every dividend. Turn ADJ on to match the measurement; either way the panel's
//   rule-vs-buy&hold comparison is internally consistent, since both legs read
//   the same price series.
//
// ─────────────────────────────────────────────────────────────────────────────────

indicator("Trend Signal (Stocks)", overlay=true)

// ── Inputs ────────────────────────────────────────────────────────────────────
maLen   = input.int(200, "Trend MA length", minval=5,
                    tooltip="200 is the canonical equity trend filter and posted the " +
                            "smallest median drawdown across 70 tickers. Sweeping this " +
                            "to find a better number is the documented overfit path.")
bandPct = input.float(1.0, "Hysteresis band %", minval=0.0, step=0.25,
                      tooltip="Dead zone around the MA that suppresses whipsaw. 0% " +
                              "trades most and drew down worst; 4% traded least. No " +
                              "band setting beat buy-and-hold on a majority of assets.")
maType  = input.string("SMA", "MA type", options=["SMA", "EMA"])

showDD  = input.bool(true, "Show drawdown panel", group="Panel",
                     tooltip="The panel is the point of this script: it compares the " +
                             "rule's drawdown against buy-and-hold on THIS symbol.")

// ── Core rule ─────────────────────────────────────────────────────────────────
// Stateless equivalent of "long above the upper band, flat below the lower band,
// hold in between": whichever band was crossed most recently wins.
ma     = maType == "EMA" ? ta.ema(close, maLen) : ta.sma(close, maLen)
upper  = ma * (1 + bandPct / 100.0)
lower  = ma * (1 - bandPct / 100.0)

bl     = ta.barssince(close > upper)
bs     = ta.barssince(close < lower)
isLong = nz(bl, 999999) < nz(bs, 999999)

buySignal  = isLong and not isLong[1]
sellSignal = not isLong and isLong[1]

// ── Live drawdown comparison (this symbol, this window) ───────────────────────
// Equity of the rule, marked to market: it moves with price while long and is
// flat while in cash. Buy-and-hold is the control. Both start at 1.0 on the
// first bar the MA exists, so the comparison is like-for-like.
var float eqRule = na
var float eqHold = na
var float peakRule = na
var float peakHold = na
var float ddRule = 0.0
var float ddHold = 0.0

ret = nz(close / close[1] - 1.0, 0.0)
if not na(ma)
    eqRule := na(eqRule) ? 1.0 : eqRule * (1 + (isLong[1] ? ret : 0.0))
    eqHold := na(eqHold) ? 1.0 : eqHold * (1 + ret)
    peakRule := na(peakRule) ? eqRule : math.max(peakRule, eqRule)
    peakHold := na(peakHold) ? eqHold : math.max(peakHold, eqHold)
    ddRule := math.min(ddRule, eqRule / peakRule - 1.0)
    ddHold := math.min(ddHold, eqHold / peakHold - 1.0)

// ── Plotting ──────────────────────────────────────────────────────────────────
plot(ma, "Trend MA", color=color.new(color.gray, 0), linewidth=2)
upPlot = plot(upper, "Upper band", color=color.new(color.gray, 70))
loPlot = plot(lower, "Lower band", color=color.new(color.gray, 70))
fill(upPlot, loPlot, color=color.new(color.gray, 92), title="Hysteresis band")

barcolor(isLong ? color.new(color.teal, 40) : color.new(color.gray, 75))

plotshape(buySignal and barstate.isconfirmed, title="BUY", location=location.belowbar,
          style=shape.labelup, color=color.new(color.teal, 0), textcolor=color.white,
          text="BUY", size=size.small)
plotshape(sellSignal and barstate.isconfirmed, title="SELL", location=location.abovebar,
          style=shape.labeldown, color=color.new(color.red, 0), textcolor=color.white,
          text="SELL", size=size.small)

// ── Alerts ────────────────────────────────────────────────────────────────────
alertcondition(buySignal,  title="BUY  — trend turned up",
               message="Trend Signal (Stocks): BUY {{ticker}} @ {{close}} (closed above band)")
alertcondition(sellSignal, title="SELL — trend turned down",
               message="Trend Signal (Stocks): SELL {{ticker}} @ {{close}} (closed below band)")

// ── Panel ─────────────────────────────────────────────────────────────────────
// Deliberately reports RETURN alongside drawdown. A panel that showed only the
// drawdown saving would be selling the tool on its good half.
var table t = table.new(position.top_right, 2, 6, border_width=1)
if showDD and barstate.islast
    table.cell(t, 0, 0, "Trend Signal (Stocks)", bgcolor=color.new(color.gray, 80),
               text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 0, isLong ? "LONG" : "CASH",
               bgcolor=isLong ? color.new(color.teal, 60) : color.new(color.gray, 60),
               text_color=isLong ? color.teal : color.gray, text_size=size.small)

    table.cell(t, 0, 1, "max DD (rule)", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, str.tostring(ddRule * 100, "#.#") + "%",
               text_color=color.teal, text_size=size.tiny)
    table.cell(t, 0, 2, "max DD (buy & hold)", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(ddHold * 100, "#.#") + "%",
               text_color=color.red, text_size=size.tiny)

    table.cell(t, 0, 3, "return (rule)", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3, str.tostring(nz(eqRule, 1.0), "#.##") + "x",
               text_color=color.gray, text_size=size.tiny)
    table.cell(t, 0, 4, "return (buy & hold)", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(nz(eqHold, 1.0), "#.##") + "x",
               text_color=color.gray, text_size=size.tiny)

    table.cell(t, 0, 5, "what this is for", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, nz(eqRule, 1.0) > nz(eqHold, 1.0) ? "beat B&H here (4% of 70 do)"
                        : "less pain, less money",
               text_color=color.orange, text_size=size.tiny)
