//@version=6
//
// TSMOM — long/cash allocation on SMA(200) with a hysteresis band
// ──────────────────────────────────────────────────────────────────────────────
// PORT OF: tsmom_paper.py  (state: data/tsmom_paper_state.json, judged by
//          proof_scorecard._tsmom_forward)
//
// WHAT IT IS
//   The lowest-turnover arm in the book. Long when the daily close sits above
//   SMA(200) by more than the band; cash when it sits below by more than the
//   band; otherwise hold whatever you already had. That "otherwise hold" IS the
//   strategy — the band exists to stop the position flipping on noise around the
//   average, at ~6-10 switches a year.
//
// WHY THIS SHAPE
//   The directional swing strategies died on the 0.54% round-trip cost wall by
//   taking frequent small trades. This is the opposite shape: cost is a footnote
//   because there are so few round trips. The 4.9-year backtest (tsmom_test.py)
//   halved drawdown vs buy-and-hold on BTC/ETH/SOL and survived honest cost.
//
// STATUS — READ BEFORE TRUSTING THE BACKTEST TAB
//   CANDIDATE, NOT PROVEN. The forward paper clock is what earns proof
//   (n>=30 closed trades, family-wise t-bar), and at ~8 switches/yr on 3 symbols
//   that is a multi-year clock. TradingView's Strategy Tester will happily print
//   a return here — that number is IN-SAMPLE on whatever window you loaded, and
//   is not evidence. See memory `trend_following_candidate`.
//
// UNIVERSE (from the runner, and it is deliberate)
//   BTC, ETH, SOL only. LTC/BCH/XRP were excluded ON PRINCIPLE, not by sweep:
//   TSMOM is meant to work on liquid trenders and to fail on choppy alts, and it
//   did. Applying this to an alt is off-spec — the chart will let you, the
//   strategy does not claim it.
//
// PARITY WITH THE RUNNER
//   The runner allocates 1/3 of a $500 book to each of the 3 symbols and charges
//   0.54% round-trip on each close. Here one chart = one symbol, so the default
//   is 100% of the chart's equity; the commission below is the same 0.54% split
//   across the two sides (0.27% each).
//
strategy("TSMOM SMA200 + band (long/cash)", overlay = true,
     default_qty_type      = strategy.percent_of_equity,
     default_qty_value     = 100,
     initial_capital       = 500,
     commission_type       = strategy.commission.percent,
     commission_value      = 0.27,       // 0.54% round trip = 0.27% per side
     process_orders_on_close = true,
     calc_on_every_tick    = false,
     pyramiding            = 0)

// ── inputs (defaults mirror the runner's env knobs) ───────────────────────────
smaN  = input.int(200,   "SMA length  (TSMOM_SMA)",  minval = 2,
     tooltip = "Daily close vs this average is the whole signal.")
band  = input.float(2.0, "Hysteresis band %  (TSMOM_BAND)", minval = 0.0, step = 0.1,
     tooltip = "Long above SMA*(1+band), cash below SMA*(1-band), hold in between. " +
               "This is the honest turnover fix — it is NOT return-tuning. " +
               "Setting it to 0 roughly doubles the number of round trips.") / 100.0
useHTF = input.bool(true, "Force daily bars regardless of chart timeframe",
     tooltip = "The spec is a DAILY-close rule. Leaving this on keeps the signal " +
               "identical whether you view it on a 4h or a weekly chart.")

// ── data: the rule is defined on daily closes ─────────────────────────────────
src = useHTF ? request.security(syminfo.tickerid, "D", close,
                    lookahead = barmerge.lookahead_off) : close
sma = useHTF ? request.security(syminfo.tickerid, "D", ta.sma(close, smaN),
                    lookahead = barmerge.lookahead_off) : ta.sma(close, smaN)

upper = sma * (1 + band)
lower = sma * (1 - band)

// ── state machine: +1 long, 0 cash, hold in the dead zone ─────────────────────
var int pos = 0
warm = not na(sma)
if warm
    if src > upper
        pos := 1
    else if src < lower
        pos := 0
    // else: hold previous pos — the band's entire purpose

// Act only on a CONFIRMED close, matching the runner's "newly-closed daily bar".
flipLong = warm and pos == 1 and pos[1] != 1
flipFlat = warm and pos == 0 and pos[1] != 0

if flipLong
    strategy.entry("LONG", strategy.long)
if flipFlat
    strategy.close("LONG", comment = "to cash")

// ── plotting ──────────────────────────────────────────────────────────────────
pSma = plot(sma,   "SMA",   color = color.new(color.orange, 0), linewidth = 2)
pUp  = plot(upper, "Upper band", color = color.new(color.teal, 55))
pLo  = plot(lower, "Lower band", color = color.new(color.maroon, 55))
fill(pUp, pLo, color = color.new(color.gray, 90), title = "Dead zone (hold)")

barcolor(pos == 1 ? color.new(color.teal, 40) : color.new(color.gray, 60))
bgcolor(pos == 1 ? color.new(color.teal, 93) : na, title = "In position")

plotshape(flipLong, "BUY",  style = shape.labelup,   location = location.belowbar,
     color = color.new(color.teal, 0),   text = "BUY",  textcolor = color.white, size = size.tiny)
plotshape(flipFlat, "CASH", style = shape.labeldown, location = location.abovebar,
     color = color.new(color.maroon, 0), text = "CASH", textcolor = color.white, size = size.tiny)

alertcondition(flipLong, "TSMOM: go LONG",  "TSMOM {{ticker}}: close cleared SMA band -> LONG")
alertcondition(flipFlat, "TSMOM: go CASH",  "TSMOM {{ticker}}: close broke SMA band -> CASH")
