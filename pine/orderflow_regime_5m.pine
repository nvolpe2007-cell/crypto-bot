//@version=6
//
// Order Flow Regime — 5-MINUTE STRATEGY (buy/sell on chart + backtest)
// ───────────────────────────────────────────────────────────────────────────────
// Same flow×OI regime edge as orderflow_regime_strategy.pine, retuned for running
// DIRECTLY on a 5-minute chart (not as an intrabar feed under a higher chart TF).
//
// WHY THIS IS NOT A 5-MINUTE SCALPER
//   This repo has already measured what "buy/sell on every 5m-scale signal with a
//   tight target" does: the microstructure scalper (src/microstructure_strategy.py)
//   took 228 trades this way and got a 0.9% win rate at 73.6% fee drag before it was
//   shut down, and the standalone tick-OFI/CVD hypothesis is filed `killed` in the
//   research ledger. Round-trip cost on Kraken taker is ~0.52%; a 5-minute bar's
//   typical move is a fraction of that. So this strategy reads its signal off 5m
//   bars but is deliberately made SELECTIVE and SLOW to exit:
//     - a raised delta-z threshold (fewer, higher-conviction signals)
//     - a wide ATR stop (does not harvest ordinary 5m whipsaw)
//     - a multi-hour time exit, not a multi-bar one
//     - a signal-persistence requirement (confirmBars) and an optional
//       breakout-confirmation filter, both aimed at ENTRY TIMING: a raw
//       z-score crossing often fires on the exact peak of a flow burst,
//       right before it fades. These make entries pickier about timing, not
//       looser about what counts as a signal.
//   If you loosen these to trade more often, you are recreating the corpse above.
//
// TWO MODES
//   Continuation — follow conviction flow: buy fresh-longs (taker buying + OI
//                  rising), short fresh-shorts. Momentum.
//   Exhaustion   — fade forced flow: buy when a long-liquidation cascade is
//                  decaying and price has stopped making new lows. Bottom-catching.
//   Run both and compare — this repo's cascade study found continuation at t=+3.7
//   vs exhaustion at t=-0.8 on a different dataset; that may or may not hold here.
//
// COSTS ARE ON BY DEFAULT AND YOU SHOULD LEAVE THEM ON
//   0.26% commission per side (Kraken taker) + 2 ticks slippage. A backtest at zero
//   cost will look dramatically better and will be fiction.
//
// HONEST FRAMING
//   This is a hypothesis you can SEE on a 5m chart, not a validated edge. No
//   walk-forward, no multiple-testing correction, TradingView's bar-close fill
//   model is kinder than reality. A good curve here is a reason to test properly
//   (paper, forward, out-of-sample) — never a reason to deploy money directly.
// ───────────────────────────────────────────────────────────────────────────────

strategy("Order Flow Regime — 5m Strategy", shorttitle = "OF Regime 5m",
     overlay                 = true,
     initial_capital         = 1000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.26,
     slippage                = 2,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     max_labels_count        = 500)

// ── inputs ────────────────────────────────────────────────────────────────────

var string GRP_MODE = "Mode"
var string GRP_FLOW = "Flow"
var string GRP_OI   = "Open interest"
var string GRP_SIG  = "Entry conditions"
var string GRP_EXIT = "Exit"

mode = input.string("Continuation", "Signal mode",
     options = ["Continuation", "Exhaustion", "Both"], group = GRP_MODE,
     tooltip = "Continuation = follow conviction flow (momentum). " +
               "Exhaustion = fade forced flow (bottom-catching). Compare them.")
allowLong  = input.bool(true,  "Allow longs",  group = GRP_MODE)
allowShort = input.bool(false, "Allow shorts", group = GRP_MODE,
     tooltip = "Off by default: this account is Kraken-spot, which cannot short.")

useLowerTf = input.bool(true, "Use intrabar volume delta", group = GRP_FLOW)
lowerTf    = input.timeframe("1", "Intrabar timeframe", group = GRP_FLOW,
     tooltip = "Must be LOWER than the chart timeframe. This strategy is built " +
               "for a 5-minute chart, so 1-minute intrabar is the sensible floor.")
zLen       = input.int(40, "Z-score length", minval = 5, group = GRP_FLOW,
     tooltip = "40 x 5m bars = ~3.3h of flow history.")

oiAuto   = input.bool(true, "Auto-detect OI symbol", group = GRP_OI)
oiManual = input.symbol("", "OI symbol override", group = GRP_OI)
oiWin    = input.int(1, "dOI lookback (bars)", minval = 1, group = GRP_OI)
minOiPct = input.float(0.3, "Min |dOI| % to call a regime", minval = 0.0,
     step = 0.1, group = GRP_OI,
     tooltip = "Lower than the 1h default (0.5) because 5m OI moves less per bar.")

zThresh = input.float(1.25, "Min |delta z| to act", minval = 0.0, step = 0.25,
     group = GRP_SIG, tooltip = "Raised above the 1h default (1.0) on purpose: " +
     "5m flow is noisier, so selectivity has to do more work than it does on " +
     "slower charts. Never lower this to force more trades.")
extLb   = input.int(24, "Extreme lookback", minval = 2, group = GRP_SIG,
     tooltip = "24 x 5m = 2h.")
decayLb = input.int(6,  "Flow decay lookback", minval = 2, group = GRP_SIG,
     tooltip = "6 x 5m = 30min.")

confirmBars = input.int(1, "Require signal to hold N bars", minval = 1, group = GRP_SIG,
     tooltip = "1 = enter the instant the flow/regime condition is true (the " +
     "original behaviour — often buys the exact peak of a flow burst, right " +
     "before it fades). 2+ requires the condition to hold on N consecutive " +
     "bars first. Tested on BTCUSDT.P 5m: the discrete OI-regime label is " +
     "noisy enough bar-to-bar that 2 filtered out EVERY signal in a 6-week " +
     "window — that's a real finding about this OI source, not a bug. " +
     "Default left at 1 (off); try 2 on your symbol and don't assume it " +
     "will behave the same. Same technique this repo already uses for " +
     "regime persistence and funding-arb entries.")
breakoutConfirm = input.bool(false, "Require a fresh local high/low on entry bar",
     group = GRP_SIG, tooltip = "When on, a long only fires if price is ALSO " +
     "making a new N-bar high on the entry bar (breakoutLb) — confirms the " +
     "move is still continuing at the moment you'd enter, not just that flow " +
     "was strong recently. Tested on BTCUSDT.P 5m: cut trade count 26->22, " +
     "raised win rate 15.4%->18.2%, cut max drawdown ~16%, left total PnL " +
     "and profit factor roughly flat — a real but modest effect, not a fix. " +
     "Off by default so you can A/B it.")
breakoutLb = input.int(10, "Breakout lookback (bars)", minval = 2, group = GRP_SIG)

holdBars = input.int(96, "Time exit (bars)", minval = 1, group = GRP_EXIT,
     tooltip = "96 x 5m = 8h. Deliberately multi-hour, not multi-bar: the cascade " +
     "study found tight trails in post-cascade conditions stopped out ~75% of the " +
     "time within hours on whipsaw, not on the thesis being wrong.")
useStop  = input.bool(true, "Use ATR stop", group = GRP_EXIT)
atrLen   = input.int(30, "ATR length", minval = 1, group = GRP_EXIT,
     tooltip = "30 x 5m = 2.5h, wide enough that ordinary 5m noise doesn't dominate it.")
atrMult  = input.float(3.0, "ATR stop multiple", minval = 0.5, step = 0.5,
     group = GRP_EXIT, tooltip = "Deliberately wide. A tight stop here harvests " +
     "whipsaw rather than protecting anything.")

// ── volume delta ──────────────────────────────────────────────────────────────

intrabarSigned = close > open ? volume : close < open ? -volume : 0.0
lowerArr = request.security_lower_tf(syminfo.tickerid, lowerTf, intrabarSigned,
     ignore_invalid_timeframe = true)
lowerOk  = not na(lowerArr) and array.size(lowerArr) > 0

span  = high - low
clv   = span == 0 ? 0.0 : ((close - low) - (high - close)) / span
proxy = clv * volume

usingIntrabar = useLowerTf and lowerOk
delta = nz(usingIntrabar ? array.sum(lowerArr) : proxy)

var float cvd = 0.0
cvd := nz(cvd[1]) + delta

zOf(src, len) =>
    m = ta.sma(src, len)
    s = ta.stdev(src, len)
    s > 0 ? (src - m) / s : 0.0

deltaZ = zOf(delta, zLen)

// ── open interest & regime ────────────────────────────────────────────────────

oiSym  = oiAuto ? syminfo.tickerid + "_OI" : oiManual
oi     = request.security(oiSym, timeframe.period, close, ignore_invalid_symbol = true)
oiPrev = nz(oi[oiWin], na)
hasOi  = not na(oi) and not na(oiPrev) and oiPrev > 0
doiPct = hasOi ? (oi - oiPrev) / oiPrev * 100.0 : na

REG_NONE  = "no OI"
REG_CHURN = "churn"
REG_FL    = "fresh longs"
REG_SC    = "short covering"
REG_FS    = "fresh shorts"
REG_LL    = "long liquidation"

regime = REG_NONE
if hasOi and delta != 0
    if math.abs(doiPct) < minOiPct
        regime := REG_CHURN
    else if delta > 0 and doiPct > 0
        regime := REG_FL
    else if delta > 0 and doiPct < 0
        regime := REG_SC
    else if delta < 0 and doiPct > 0
        regime := REG_FS
    else if delta < 0 and doiPct < 0
        regime := REG_LL

// ── exhaustion ────────────────────────────────────────────────────────────────
// Both conditions compare against the PRIOR window, never one including the
// current bar: a rolling extreme containing the current bar can never be
// exceeded by it, so a flat tape — exactly what exhaustion looks like — would
// never register.

mag       = math.abs(delta)
priorMag  = ta.sma(mag[1], decayLb)
decaying  = not na(priorMag) and mag < priorMag
priorMin  = ta.lowest(low[1], extLb)
priorMax  = ta.highest(high[1], extLb)
noNewLow  = not na(priorMin) and low  >= priorMin
noNewHigh = not na(priorMax) and high <= priorMax

exhaustLong  = regime == REG_LL and decaying and noNewLow
exhaustShort = regime == REG_SC and decaying and noNewHigh

// ── entry conditions ──────────────────────────────────────────────────────────

strongFlow = math.abs(deltaZ) >= zThresh
wantCont = mode == "Continuation" or mode == "Both"
wantExh  = mode == "Exhaustion"   or mode == "Both"

contLong  = wantCont and regime == REG_FL and deltaZ >=  zThresh
contShort = wantCont and regime == REG_FS and deltaZ <= -zThresh
exhLong   = wantExh  and exhaustLong  and strongFlow
exhShort  = wantExh  and exhaustShort and strongFlow

rawLong  = contLong  or exhLong
rawShort = contShort or exhShort

// Persistence: the raw condition must hold `confirmBars` consecutive bars,
// not just the one bar it first crossed the threshold on. confirmBars=1 is
// the original, unfiltered behaviour.
var int longStreak  = 0
var int shortStreak = 0
longStreak  := rawLong  ? longStreak  + 1 : 0
shortStreak := rawShort ? shortStreak + 1 : 0
persistLong  = longStreak  >= confirmBars
persistShort = shortStreak >= confirmBars

// Breakout confirmation: price must ALSO be making a fresh local extreme on
// the entry bar itself, so the move is still moving at the moment of entry
// rather than just having moved recently.
priorHighBo = ta.highest(high[1], breakoutLb)
priorLowBo  = ta.lowest(low[1], breakoutLb)
breakoutLongOk  = not breakoutConfirm or (not na(priorHighBo) and high >= priorHighBo)
breakoutShortOk = not breakoutConfirm or (not na(priorLowBo)  and low  <= priorLowBo)

longSignal  = allowLong  and persistLong  and breakoutLongOk
shortSignal = allowShort and persistShort and breakoutShortOk

// ── execution ─────────────────────────────────────────────────────────────────

atr = ta.atr(atrLen)

if longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
if shortSignal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)

// Time exit, counted from the bar the position opened on.
barsHeld = strategy.position_size != 0 ? bar_index - strategy.opentrades.entry_bar_index(0) : 0
if strategy.position_size != 0 and barsHeld >= holdBars
    strategy.close_all(comment = "time")

if useStop and strategy.position_size > 0
    strategy.exit("Long stop", from_entry = "Long",
         stop = strategy.position_avg_price - atrMult * atr)
if useStop and strategy.position_size < 0
    strategy.exit("Short stop", from_entry = "Short",
         stop = strategy.position_avg_price + atrMult * atr)

// ── chart markers ─────────────────────────────────────────────────────────────

plotshape(longSignal  and strategy.position_size == 0, "BUY", shape.labelup,
     location.belowbar, color.new(#26a69a, 0), text = "BUY",
     textcolor = color.white, size = size.small)
plotshape(shortSignal and strategy.position_size == 0, "SELL", shape.labeldown,
     location.abovebar, color.new(#ef5350, 0), text = "SELL",
     textcolor = color.white, size = size.small)

bgcolor(regime == REG_LL ? color.new(#ef5350, 90) :
        regime == REG_SC ? color.new(#26a69a, 90) : na, title = "Forced regime")

// ── status table ──────────────────────────────────────────────────────────────

if barstate.islast
    var table t = table.new(position.top_right, 2, 5,
         frame_color = color.new(color.gray, 70), frame_width = 1)
    txt = color.new(color.gray, 0)
    val = color.new(#b2b5be, 0)
    warn = color.new(#ffa726, 0)

    table.cell(t, 0, 0, "source",  text_color = txt, text_size = size.tiny)
    table.cell(t, 1, 0, usingIntrabar ? lowerTf + " intrabar" : "bar proxy",
         text_color = usingIntrabar ? val : warn, text_size = size.tiny)
    table.cell(t, 0, 1, "mode",    text_color = txt, text_size = size.tiny)
    table.cell(t, 1, 1, mode, text_color = val, text_size = size.tiny)
    table.cell(t, 0, 2, "delta z", text_color = txt, text_size = size.tiny)
    table.cell(t, 1, 2, str.tostring(deltaZ, "#.00"), text_color = val, text_size = size.tiny)
    table.cell(t, 0, 3, "dOI %",   text_color = txt, text_size = size.tiny)
    table.cell(t, 1, 3, hasOi ? str.tostring(doiPct, "#.###") + "%" : "n/a",
         text_color = hasOi ? val : warn, text_size = size.tiny)
    table.cell(t, 0, 4, "regime",  text_color = txt, text_size = size.tiny)
    table.cell(t, 1, 4, regime, text_color = val, text_size = size.tiny)
